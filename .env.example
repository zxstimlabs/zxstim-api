# Required
DATABASE_PATH=./sqlite.db
ARBITRUM_SEPOLIA_RPC_URL=
# Hot manager wallet (sponsor/claim/delegate). Its address is derived from this key.
HOT_MANAGER_WALLET_PRIVATE_KEY=

# Optional
# BACKFILL_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# HOST=127.0.0.1
# PORT=8001
# Enables the ETH/VND order-book bot (Redis-backed); off when unset.
# REDIS_URL=redis://localhost:6379

# CeFi API (api.cefi.vn), a second listener; off unless CEFI_ENABLED=1.
# Needs REDIS_URL plus both secrets (each ≥ 32 chars, e.g. `openssl rand -base64 48`).
# Never change CEFI_PIN_PEPPER once accounts exist: every PIN would stop working.
# CEFI_ENABLED=1
# CEFI_PORT=8002
# CEFI_DATABASE_PATH=./cefi.db
# BETTER_AUTH_SECRET=
# CEFI_PIN_PEPPER=
# Local dev overrides (production uses https://api.cefi.vn, rpID cefi.vn):
# CEFI_BASE_URL=http://localhost:8002
# CEFI_RP_ID=localhost
# CEFI_EXTRA_ORIGINS=http://localhost:5173
