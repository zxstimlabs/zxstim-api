{
  "name": "zxstim-api",
  "version": "1.0.50",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile ./build/zxstim-api src/index.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun run src/lib/migrate.ts"
  },
  "dependencies": {
    "@elysia/cron": "^1.4.2",
    "@elysiajs/cors": "1.4.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "elysia": "latest",
    "ox": "^0.14.22",
    "viem": "^2.50.4"
  },
  "devDependencies": {
    "bun-types": "latest",
    "drizzle-kit": "^0.31.10"
  },
  "module": "src/index.js"
}
